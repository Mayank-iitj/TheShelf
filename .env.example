# Groq API Key for the AI Agent
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key — used ONLY by the Masterplan feature (server/agents/masterplan.js),
# for Google Search-grounded roadmap generation. Every other agent still uses Groq.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Express Server Port (default: 3001)
PORT=3001

# Environment mode (development or production)
NODE_ENV=development
